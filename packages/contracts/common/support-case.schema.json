        "state",
        "observed_at",
        "observation_source",
        "note_ref",
        "status_evidence_ref",
        "reissue_allowed"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "receiving",
                  "staged",
                  "committed",
                  "outcome_unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reissue_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "committed"
              }
            }
          },
          "then": {
            "properties": {
              "note_ref": {
                "$ref": "#/$defs/SupportNoteRef"
              },
              "status_evidence_ref": {
                "$ref": "urn:opentour:common-contract:1.0#/$defs/VersionedResourceRef"
              },
              "observation_source": {
