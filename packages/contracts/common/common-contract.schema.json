{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentour:common-contract:1.0",
  "title": "OpenTour common implementation contracts",
  "description": "Specification only. Structural validity does not establish authorization, truth or production readiness.",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "minor_units"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 3,
          "maxLength": 3
        },
        "minor_units": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "issuer"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "workload"
          ]
        },
        "subject": {
          "$ref": "#/$defs/Id"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "delegated_grant_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "revision",
        "sha256",
        "manifest_id",
        "environment_id",
        "classification",
        "purpose_grant_id"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/Id"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "manifest_id": {
          "$ref": "#/$defs/Id"
        },
        "environment_id": {
          "$ref": "#/$defs/Id"
        },
        "classification": {
          "enum": [
            "control_metadata",
            "customer_confidential",
            "protected_evaluation",
            "model_artifact"
          ]
        },
        "purpose_grant_id": {
          "$ref": "#/$defs/Id"
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CommandContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "organization_id",
        "actor",
        "authority_revision",
        "revocation_epoch",
        "idempotency_key",
        "created_at",
        "expires_at",
        "manifest_refs",
        "expected_revision",
        "request_nonce"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "organization_id": {
          "$ref": "#/$defs/Id"
        },
        "workspace_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "environment_id": {
          "$ref": "#/$defs/Id"
        },
        "cell_id": {
          "$ref": "#/$defs/Id"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "authority_revision": {
          "$ref": "#/$defs/Id"
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "manifest_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployment_mode": {
          "enum": [
            "customer_controlled",
            "opentour_managed"
          ]
        },
        "request_nonce": {
          "$ref": "#/$defs/Id"
        }
      },
      "description": "Tenant-scoped admitted command. Parent operations omit inapplicable child IDs. Pre-organization identity/bootstrap endpoints use their dedicated authenticated contracts, not invented organization IDs."
    },
    "JobEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "job_id",
        "action",
        "runner_protocol",
        "reservation_id",
        "limits",
        "lease_expires_at",
        "fencing_token",
        "egress_policy_sha256"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/CellCommandContext"
        },
        "job_id": {
          "$ref": "#/$defs/Id"
        },
        "action": {
          "enum": [
            "capture.import",
            "source.snapshot",
            "cases.reconstruct",
            "graph.index",
            "verifier.qualify",
            "scope.discover",
            "experiment.run",
            "dataset.seal",
            "synthetic.generate",
            "benchmark.seal",
            "training.run",
            "candidate.qualify",
            "evaluation.run",
            "deployment.stage",
            "deployment.promote",
            "deployment.rollback",
            "monitor.observe",
            "change.plan",
            "value.calculate",
            "package.build",
            "data.delete"
          ]
        },
        "runner_protocol": {
          "type": "string",
          "minLength": 1
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_runtime_seconds",
            "max_attempts",
            "max_gpu_count",
            "max_output_bytes"
          ],
          "properties": {
            "max_runtime_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "max_gpu_count": {
              "type": "integer",
              "minimum": 0
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "lease_expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        },
        "egress_policy_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "ResultReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipt_id",
        "organization_id",
        "environment_id",
        "job_id",
        "attempt_id",
        "provider_job_id",
        "input_manifest_sha256",
        "output_refs",
        "runtime_manifest_sha256",
        "started_at",
        "finished_at",
        "outcome",
        "resource_counters",
        "cost_state",
        "assurance",
        "signer_id",
        "signature_ref",
        "cell_id",
        "request_id",
        "request_nonce",
        "command_sha256",
        "authority_revision",
        "revocation_epoch"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "receipt_id": {
          "$ref": "#/$defs/Id"
        },
        "organization_id": {
          "$ref": "#/$defs/Id"
        },
        "environment_id": {
          "$ref": "#/$defs/Id"
        },
        "job_id": {
          "$ref": "#/$defs/Id"
        },
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "provider_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "output_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "runtime_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "resource_counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gpu_seconds",
            "cpu_seconds",
            "output_bytes",
            "unknown_reasons"
          ],
          "properties": {
            "gpu_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "cpu_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "output_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "unknown_reasons": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "gpu_seconds",
                  "cpu_seconds",
                  "output_bytes"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Each null counter must have a matching unknown_reasons entry; known zero means observed zero. Semantic validator enforces this equivalence.",
          "allOf": [
            {
              "if": {
                "properties": {
                  "gpu_seconds": {
                    "type": "null"
                  }
                },
                "required": [
                  "gpu_seconds"
                ]
              },
              "then": {
                "properties": {
                  "unknown_reasons": {
                    "required": [
                      "gpu_seconds"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "unknown_reasons": {
                    "not": {
                      "required": [
                        "gpu_seconds"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "cpu_seconds": {
                    "type": "null"
                  }
                },
                "required": [
                  "cpu_seconds"
                ]
              },
              "then": {
                "properties": {
                  "unknown_reasons": {
                    "required": [
                      "cpu_seconds"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "unknown_reasons": {
                    "not": {
                      "required": [
                        "cpu_seconds"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "output_bytes": {
                    "type": "null"
                  }
                },
                "required": [
                  "output_bytes"
                ]
              },
              "then": {
                "properties": {
                  "unknown_reasons": {
                    "required": [
                      "output_bytes"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "unknown_reasons": {
                    "not": {
                      "required": [
                        "output_bytes"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "cost_state": {
          "enum": [
            "estimated",
            "pending_provider_reconciliation",
            "reconciled"
          ]
        },
        "assurance": {
          "enum": [
            "runner_reported",
            "replay_verified",
            "independently_controlled"
          ]
        },
        "signer_id": {
          "$ref": "#/$defs/Id"
        },
        "signature_ref": {
          "$ref": "#/$defs/Id"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "cell_id": {
          "$ref": "#/$defs/Id"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "request_nonce": {
          "$ref": "#/$defs/Id"
        },
        "command_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "authority_revision": {
          "$ref": "#/$defs/Id"
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Signed canonical receipt binds exact command digest, nonce, authority and cell. Signature verification is necessary, not sufficient for semantic truth."
    },
    "EvaluationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id",
        "evaluation_design_ref",
        "candidate_manifest_ref",
        "comparator_manifest_ref",
        "benchmark_manifest_ref",
        "protected_use_ledger_ref"
      ],
      "properties": {
        "evaluation_design_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "candidate_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "comparator_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "benchmark_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "protected_use_ledger_ref": {
          "$ref": "#/$defs/Id"
        },
        "evaluation_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id",
        "retryable",
        "field_errors",
        "current_revision"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "retryable": {
          "type": "boolean"
        },
        "field_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "code"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          }
        },
        "current_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRevision"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CellCommandContext": {
      "allOf": [
        {
          "$ref": "#/$defs/CommandContext"
        },
        {
          "required": [
            "workspace_id",
            "project_id",
            "environment_id",
            "cell_id",
            "deployment_mode"
          ]
        }
      ]
    },
    "ResourceRevision": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "minLength": 1,
      "maxLength": 19,
      "description": "Canonical positive decimal string counter, maximum9223372036854775807. No numeric coercion. Distinct from opaque artifact/authority revision IDs.",
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "VersionedResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/ResourceRevision"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "description": "Exact mutable aggregate reference; immutable artifact/receipt uses ArtifactRef. Expected revision is consumed by its declared mutation, not a permanent frozen-plan authorization."
    },
    "SafeNonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "SafePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
