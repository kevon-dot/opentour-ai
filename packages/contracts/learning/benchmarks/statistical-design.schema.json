{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentour:contracts:learning:statistical-inference:v1",
  "title": "StatisticalInferenceContract",
  "$defs": {
    "GateRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "metric_ref",
        "operator",
        "threshold",
        "unit",
        "alpha_allocation",
        "required",
        "fatal_on_known_failure",
        "minimum_independent_units",
        "required_coverage_policy_ref"
      ],
      "properties": {
        "gate_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        },
        "metric_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        },
        "operator": {
          "enum": [
            "lower_bound_ge",
            "upper_bound_le",
            "point_ge",
            "point_le",
            "all_checks_pass"
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "alpha_allocation": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "fatal_on_known_failure": {
          "type": "boolean"
        },
        "minimum_independent_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required_coverage_policy_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "all_checks_pass"
              }
            }
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "null"
              },
              "alpha_allocation": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "threshold": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "lower_bound_ge",
                  "upper_bound_le"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "alpha_allocation": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      ]
    },
    "AnalysisLook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "look_id",
        "cumulative_independent_units",
        "claim_alpha"
      ],
      "properties": {
        "look_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        },
        "cumulative_independent_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "claim_alpha": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "minProperties": 1
        }
      }
    },
    "InferencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_unit",
        "cluster_method_ref",
        "paired_effect_method",
        "confidence_level",
        "critical_bound_method",
        "multiplicity_policy_ref",
        "stopping_mode",
        "look_plan",
        "repetitions",
        "nuisance_assumptions_ref",
        "effect_interval_sides",
        "retention_interval_sides"
      ],
      "properties": {
        "independent_unit": {
          "enum": [
            "case",
            "family"
          ]
        },
        "cluster_method_ref": {
          "anyOf": [
            {
              "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "paired_effect_method": {
          "enum": [
            "paired_binary_exact_marginals_v1",
            "bounded_independent_family_hoeffding_v1"
          ]
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "critical_bound_method": {
          "const": "binomial_clopper_pearson_one_sided_v1"
        },
        "multiplicity_policy_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        },
        "stopping_mode": {
          "enum": [
            "fixed_final",
            "bonferroni_finite_looks"
          ]
        },
        "look_plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisLook"
          },
          "minItems": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nuisance_assumptions_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        },
        "effect_interval_sides": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "retention_interval_sides": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stopping_mode": {
                "const": "fixed_final"
              }
            }
          },
          "then": {
            "properties": {
              "look_plan": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "independent_unit": {
                "const": "family"
              }
            }
          },
          "then": {
            "properties": {
              "paired_effect_method": {
                "const": "bounded_independent_family_hoeffding_v1"
              },
              "cluster_method_ref": {
                "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
              }
            }
          },
          "else": {
            "properties": {
              "paired_effect_method": {
                "const": "paired_binary_exact_marginals_v1"
              },
              "cluster_method_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "independent_unit": {
                "const": "case"
              }
            }
          },
          "then": {
            "properties": {
              "repetitions": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "EffectRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_ref",
        "minimum_gain",
        "independent_unit"
      ],
      "properties": {
        "metric_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        },
        "minimum_gain": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "independent_unit": {
          "enum": [
            "case",
            "family"
          ]
        }
      }
    },
    "CriticalLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "metric_ref",
        "max_error_rate",
        "minimum_exposures"
      ],
      "properties": {
        "slice_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        },
        "metric_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        },
        "max_error_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "minimum_exposures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "RetentionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_ref",
        "max_degradation"
      ],
      "properties": {
        "metric_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        },
        "max_degradation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "CoverageRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_ref",
        "min_gradeable_fraction",
        "required_slice_ids",
        "missingness_policy"
      ],
      "properties": {
        "population_ref": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ArtifactRef"
        },
        "min_gradeable_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "required_slice_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
          },
          "minItems": 0
        },
        "missingness_policy": {
          "const": "hold_if_required_unknown"
        }
      }
    },
    "GatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_gates",
        "fatal_gate_ids",
        "effect_requirement",
        "critical_limits",
        "retention_margin",
        "coverage_requirement"
      ],
      "properties": {
        "required_gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateRequirement"
          },
          "minItems": 1
        },
        "fatal_gate_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
          },
          "minItems": 0
        },
        "effect_requirement": {
          "$ref": "#/$defs/EffectRequirement"
        },
        "critical_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CriticalLimit"
          },
          "minItems": 0
        },
        "retention_margin": {
          "$ref": "#/$defs/RetentionRequirement"
        },
        "coverage_requirement": {
          "$ref": "#/$defs/CoverageRequirement"
        }
      }
    }
  },
  "description": "Closed production method registry. Cross-field alpha sums, unique gate IDs, method assumptions and independent-unit compatibility require the explicitly specified semantic validator; structural validity alone does not authorize use.",
  "$ref": "#/$defs/InferencePlan"
}
