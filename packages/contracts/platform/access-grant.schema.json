        "organization_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        }
      },
      "required": [
        "workspace_ids",
        "project_ids",
        "environment_ids",
        "artifact_refs",
        "support_note_scopes",
        "organization_id"
