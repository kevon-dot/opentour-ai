    "GrantOperationView": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        },
        "operation_kind": {
          "const": "access_grant_create",
          "type": "string"
        },
        "operation_revision": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ResourceRevision"
        },
        "grant_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        },
        "state": {
          "enum": [
            "prepared",
            "reconciliation_required",
            "succeeded",
            "aborted"
          ],
          "type": "string"
        },
        "creation_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/GrantCreationReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_grant_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/GrantCurrentStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_status_unavailable_reason": {
          "anyOf": [
            {
              "enum": [
                "AUTHORITY_UNAVAILABLE",
                "RECONCILIATION_REQUIRED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        }
      },
      "required": [
        "operation_id",
        "operation_kind",
        "operation_revision",
        "grant_id",
        "state",
        "creation_receipt",
        "current_grant_status",
        "current_status_unavailable_reason",
        "request_id"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "prepared",
                  "reconciliation_required",
                  "aborted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "creation_receipt": {
                "type": "null"
              },
              "current_grant_status": {
                "type": "null"
              },
              "current_status_unavailable_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "creation_receipt": {
                "$ref": "#/$defs/GrantCreationReceipt"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "current_grant_status": {
                    "type": "null"
                  },
                  "current_status_unavailable_reason": {
                    "enum": [
                      "AUTHORITY_UNAVAILABLE",
                      "RECONCILIATION_REQUIRED"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "current_grant_status": {
                    "$ref": "#/$defs/GrantCurrentStatus"
                  },
                  "current_status_unavailable_reason": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      ]
    }
