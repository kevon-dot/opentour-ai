    "GrantCurrentStatus": {
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
        },
        "revision": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/ResourceRevision"
        },
        "state": {
          "enum": [
            "not_yet_valid",
            "active",
            "expired",
            "revoked"
          ],
          "type": "string"
        },
        "authority_status": {
          "enum": [
            "current",
            "reconciliation_required",
            "unavailable"
          ],
          "type": "string"
        },
        "observed_at": {
          "$ref": "urn:opentour:common-contract:1.0#/$defs/Timestamp"
        }
      },
      "required": [
        "grant_id",
        "revision",
        "state",
        "authority_status",
        "observed_at"
      ],
      "type": "object"
