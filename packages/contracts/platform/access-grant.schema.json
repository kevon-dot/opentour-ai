{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentour:access-grant:1.0",
  "description": "Closed grant request and metadata receipts. Definition library: consumers must select a definition. Shape validation is not current identity, ownership, policy or verified journal authority. Semantic validators enforce timestamp ordering and matching receipt grant IDs.",
