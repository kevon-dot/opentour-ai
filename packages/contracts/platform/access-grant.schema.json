    "InputResourceScope": {
      "additionalProperties": false,
      "properties": {
        "workspace_ids": {
          "items": {
            "$ref": "urn:opentour:common-contract:1.0#/$defs/Id"
          },
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100
        },
        "project_ids": {
          "items": {
