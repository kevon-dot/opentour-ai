{
  "display_information": {
    "name": "OpenTour Pilot",
    "description": "Inspect an approved dataset, tune locally and review frozen pilot results."
  },
  "features": {
    "bot_user": {"display_name": "OpenTour Pilot", "always_online": false},
    "slash_commands": [{
      "command": "/opentour",
      "description": "Open the private pilot workspace",
      "usage_hint": "[data | search FIELD | status JOB]",
      "should_escape": false
    }]
  },
  "oauth_config": {"scopes": {"bot": ["commands", "groups:read", "chat:write"]}},
  "settings": {
    "socket_mode_enabled": true,
    "interactivity": {"is_enabled": true},
    "org_deploy_enabled": false
  }
}
